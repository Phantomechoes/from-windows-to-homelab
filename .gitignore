# Machine-local secrets. None of these belong in this repository.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ed25519_*
id_ecdsa
id_ecdsa.pub
*.cert

# Live captive-portal credentials. The server keeps these in a root-only
# directory. Do not copy that directory here, under either name.
bjtu-auth/
captive-portal/
secrets/

# Local netplan or SSH snippets with a real SSID, IP, or MAC.
*.local
*.local.yaml
*.local.yml
override.yaml
override.yml

# Unredacted captures.
*.log
*.pcap
*.pcapng
screenshots/
raw/
private/

# Editor and OS noise.
.DS_Store
.idea/
.vscode/
*.swp
*~

# Env templates may use these names. The ignore rules above still catch real env files.
!.env.example
!**/.env.example
!*.example.env

# Image archives and the static BusyBox copied into a build context.
*.tar
*.tar.gz
*.oci
busybox
